pw.println("<a href='/styleonep/index.html '>Home</a>");
pw.println("");
pw.println("");
pw.println("");
pw.println("</div><!--left Panel ends here-->");
pw.println("<!--right Panel starts here-->");
pw.println("<div style='height:32vw;margin-left:105px;margin-right:5px;margin-top:5px;padding:5px;border:1px solid black'>");
pw.println("<h2>Designation (delete Module)</h2>");
pw.println("<form action='/styleonep/deleteDesignation ' onsubmit='return validateForm(this)'>");
pw.println("Designation:");
pw.println("<b>\"+title+\"</b>");
